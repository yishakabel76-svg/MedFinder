# PostgreSQL connection used by the app and Drizzle ORM.
# Adjust the port if your PostgreSQL server runs elsewhere.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medfinder

# Optional: override the seeded administrator account.
# These are only used the first time the admin account is created.
# ADMIN_EMAIL=admin@medfinder.local
# ADMIN_PASSWORD=Admin123!
